#!/usr/bin/env bash
#
# Update each skill's SKILL.md from its upstream source.
#
# A skill is tracked by placing a "source.json" next to its SKILL.md:
#
#   {
#     "description": "One-line summary of what the skill does.",
#     "repo": "https://github.com/USER/REPO/blob/BRANCH/path/to/SKILL.md"
#   }
#
# "repo" is the normal GitHub blob URL you'd open in a browser. This script
# derives the raw URL, fetches the latest content, and replaces SKILL.md only
# if it actually changed. Skills without a source.json are left untouched.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILLS_DIR="$REPO_ROOT/skills"

if ! command -v curl >/dev/null 2>&1; then
  echo "Error: curl is not installed." >&2
  echo >&2
  echo "Install it with Homebrew, then re-run this script:" >&2
  echo "    brew install curl" >&2
  exit 1
fi

# Turn a GitHub "blob" URL into its raw.githubusercontent.com equivalent.
#   https://github.com/USER/REPO/blob/BRANCH/path  ->
#   https://raw.githubusercontent.com/USER/REPO/BRANCH/path
to_raw_url() {
  printf '%s\n' "$1" | sed -E 's#https://github\.com/([^/]+)/([^/]+)/blob/#https://raw.githubusercontent.com/\1/\2/#'
}

updated=0
unchanged=0
skipped=0

for source_file in "$SKILLS_DIR"/*/source.json; do
  [ -e "$source_file" ] || continue
  skill_dir="$(dirname "$source_file")"
  name="$(basename "$skill_dir")"
  skill_file="$skill_dir/SKILL.md"

  # Pull the GitHub URL out of source.json (flat JSON, dependency-free parse).
  repo_url="$(grep -oE '"repo"[[:space:]]*:[[:space:]]*"[^"]*"' "$source_file" \
    | sed -E 's/.*:[[:space:]]*"([^"]*)"/\1/' | head -1)"

  if [ -z "$repo_url" ]; then
    echo "skip      $name (source.json has no \"repo\")"
    skipped=$((skipped + 1))
    continue
  fi

  raw_url="$(to_raw_url "$repo_url")"

  tmp="$(mktemp)"
  if ! curl -fsSL "$raw_url" -o "$tmp"; then
    echo "fail      $name (could not fetch $raw_url)"
    rm -f "$tmp"
    skipped=$((skipped + 1))
    continue
  fi

  if [ -f "$skill_file" ] && cmp -s "$tmp" "$skill_file"; then
    echo "unchanged $name"
    rm -f "$tmp"
    unchanged=$((unchanged + 1))
    continue
  fi

  mv "$tmp" "$skill_file"
  echo "updated   $name"
  updated=$((updated + 1))
done

echo
echo "Updated $updated, unchanged $unchanged, skipped $skipped."

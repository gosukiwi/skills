#!/usr/bin/env bash
#
# Link this repo's skills into an agent's skills directory.
#
# This is the script for people who are NOT the repo owner. Unlike bin/install
# (which mirrors skills/ into ~/.agents/skills with rsync --delete), this never
# removes anything you didn't put there: each entry in skills/ — including
# shared/ — becomes a symlink in the destination. Running it again is safe: it
# refreshes what it installed and skips any name it doesn't own.
#
# The skills symlink back into this checkout, so `git pull` here is what updates
# them; re-run afterwards to link any skills added upstream.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILLS_DIR="$REPO_ROOT/skills"

CLAUDE_DEST="$HOME/.claude/skills"
AGENTS_DEST="$HOME/.agents/skills"

DEST=""
USE_COPY=0
DO_UPDATE=0
ASSUME_YES=0

usage() {
  cat <<'EOF'
Link this repo's skills into an agent's skills directory.

Usage: bin/setup-gosukiwi [options]

Options:
  --dest DIR   Link into DIR (skips the prompt)
  --copy       Copy the files instead of symlinking
  --update     git pull --ff-only before linking
  -y, --yes    Take the default destination (~/.claude/skills)
  -h, --help   Show this help

Safe to re-run: it refreshes what it installed and skips any skill you already
have under the same name. To update, `git pull` in the repo and run this again.
EOF
}

die() { echo "Error: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dest)
      [ $# -ge 2 ] || die "--dest needs a directory"
      DEST="$2"
      shift 2
      ;;
    --dest=*) DEST="${1#--dest=}"; shift ;;
    --copy) USE_COPY=1; shift ;;
    --update) DO_UPDATE=1; shift ;;
    -y|--yes) ASSUME_YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1 (try --help)" ;;
  esac
done

[ -d "$SKILLS_DIR" ] || die "couldn't find skills/ next to this script (looked in $REPO_ROOT)."

# Symlinking needs 'ln', copying needs 'cp'; git is only needed to update.
if [ "$USE_COPY" -eq 1 ]; then
  command -v cp >/dev/null 2>&1 || die "'cp' is not installed."
else
  command -v ln >/dev/null 2>&1 || die "'ln' is not installed."
fi

HAVE_GIT=1
if ! command -v git >/dev/null 2>&1; then
  HAVE_GIT=0
fi

if [ "$DO_UPDATE" -eq 1 ]; then
  [ "$HAVE_GIT" -eq 1 ] || die "--update needs git, which isn't installed. Install git, or drop --update."
  [ -d "$REPO_ROOT/.git" ] || die "--update needs a git checkout; $REPO_ROOT is not one."
  echo "Updating $REPO_ROOT"
  git -C "$REPO_ROOT" pull --ff-only
elif [ "$HAVE_GIT" -eq 0 ]; then
  echo "Note: git not found, so --update is unavailable."
fi

# Ask where to link, unless --dest or -y already decided.
pick_dest() {
  if [ -n "$DEST" ]; then
    printf '%s\n' "$DEST"
    return
  fi

  if [ "$ASSUME_YES" -eq 1 ] || [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
    printf '%s\n' "$CLAUDE_DEST"
    return
  fi

  {
    echo
    echo "Where should I link the skills?"
    echo "  1) $CLAUDE_DEST  (Claude Code)"
    echo "  2) $AGENTS_DEST  (Codex, Cursor, other agents)"
    echo "  3) A custom path"
    printf 'Choose [1]: '
  } > /dev/tty

  local answer custom
  read -r answer < /dev/tty || answer=""
  case "$answer" in
    ""|1) printf '%s\n' "$CLAUDE_DEST" ;;
    2) printf '%s\n' "$AGENTS_DEST" ;;
    3)
      printf 'Path: ' > /dev/tty
      read -r custom < /dev/tty || custom=""
      [ -n "$custom" ] || die "no path given."
      printf '%s\n' "$custom"
      ;;
    *) die "unrecognized choice: $answer" ;;
  esac
}

DEST="$(pick_dest)"
DEST="${DEST/#\~/$HOME}"
case "$DEST" in
  /*) ;;
  *) DEST="$PWD/$DEST" ;;
esac

mkdir -p "$DEST" || die "couldn't create $DEST"

# --copy records what it installed so a later run can refresh those copies
# without touching a skill of yours that happens to share a name.
COPY_MANIFEST="$DEST/.setup-gosukiwi-manifest"
is_owned_copy() {
  [ -f "$COPY_MANIFEST" ] && grep -Fxq -- "$1" "$COPY_MANIFEST"
}

echo "Linking skills from $SKILLS_DIR"
echo "                 to $DEST"

linked=0
refreshed=0
unchanged=0
skipped=0
failed=0
installed="$(mktemp)"

for entry in "$SKILLS_DIR"/*; do
  [ -e "$entry" ] || continue
  name="$(basename "$entry")"
  target="$DEST/$name"
  was_refresh=0

  # A symlink we made earlier: leave it alone, or skip if it points elsewhere.
  if [ -L "$target" ] && [ "$USE_COPY" -eq 0 ]; then
    if [ "$(readlink "$target")" = "$entry" ]; then
      echo "  ok      $name"
      unchanged=$((unchanged + 1))
    else
      echo "  skip    $name (symlink to $(readlink "$target"))"
      skipped=$((skipped + 1))
    fi
    continue
  fi

  # Something is already there.
  if [ -e "$target" ]; then
    if [ "$USE_COPY" -eq 1 ] && is_owned_copy "$name"; then
      if rm -rf "$target"; then
        was_refresh=1
      else
        echo "  fail    $name" >&2
        failed=$((failed + 1))
        continue
      fi
    else
      echo "  skip    $name (already exists, not ours)"
      skipped=$((skipped + 1))
      continue
    fi
  fi

  if [ "$USE_COPY" -eq 1 ]; then
    if cp -R "$entry" "$target"; then
      if [ "$was_refresh" -eq 1 ]; then
        echo "  refresh $name"
        refreshed=$((refreshed + 1))
      else
        echo "  copied  $name"
        linked=$((linked + 1))
      fi
      printf '%s\n' "$name" >> "$installed"
    else
      echo "  fail    $name" >&2
      failed=$((failed + 1))
    fi
  else
    if ln -s "$entry" "$target"; then
      echo "  linked  $name"
      linked=$((linked + 1))
    else
      echo "  fail    $name" >&2
      failed=$((failed + 1))
    fi
  fi
done

if [ "$USE_COPY" -eq 1 ]; then
  sort -u "$installed" > "$COPY_MANIFEST"
fi
rm -f "$installed"

echo
echo "Linked $linked, refreshed $refreshed, unchanged $unchanged, skipped $skipped, failed $failed."
if [ "$USE_COPY" -eq 1 ]; then
  echo "Copies are snapshots: run 'git -C \"$REPO_ROOT\" pull' then this script again to refresh them."
else
  echo "They point into $REPO_ROOT, so 'git -C \"$REPO_ROOT\" pull' updates them."
fi

[ "$failed" -eq 0 ] || exit 1
